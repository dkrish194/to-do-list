worker_processes auto;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format json_combined escape=json
      '{'
      '"timestamp":"$time_iso8601",'
      '"app":"todo-frontend",'
      '"remote_addr":"$remote_addr",'
      '"method":"$request_method",'
      '"path":"$uri",'
      '"status":$status,'
      '"body_bytes_sent":$body_bytes_sent,'
      '"request_time":$request_time,'
      '"user_agent":"$http_user_agent"'
      '}';

    access_log /dev/stdout json_combined;
    error_log  /dev/stderr warn;

    server {
        listen ${NGINX_PORT};
        root /usr/share/nginx/html;
        index index.html;

        # Reverse proxy to the backend - runs INSIDE the cluster, so it can
        # resolve the backend's ClusterIP Service DNS name (e.g. "todo-backend")
        # even though the browser itself never could. This is what lets the
        # backend Service stay ClusterIP-only, never exposed externally.
        location ~ ^/(api|version) {
            proxy_pass http://${BACKEND_PROXY_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 5s;
            proxy_read_timeout 35s;   # covers the /api/simulate/slow?delay=30 test endpoint
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /healthz {
            return 200 '{"status":"ok"}';
            add_header Content-Type application/json;
        }
    }
}
